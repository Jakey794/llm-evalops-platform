# Frontend environment template for Vercel / local Next.js

# Server-only URL of the Cloud Run (or local) FastAPI backend.
BACKEND_API_BASE_URL=http://localhost:8000

# Server-only service credentials. Use independent random values of 32+ characters.
BACKEND_VIEWER_TOKEN=replace-with-random-viewer-token
BACKEND_OPERATOR_TOKEN=replace-with-random-operator-token

# Dashboard session signing and access passwords. Never prefix these with NEXT_PUBLIC_.
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
APP_VIEWER_PASSWORD=replace-with-a-strong-viewer-password
APP_OPERATOR_PASSWORD=replace-with-a-strong-operator-password

# Canonical public frontend URL used by search and social metadata.
NEXT_PUBLIC_SITE_URL=https://llm-evalops-platform.vercel.app
